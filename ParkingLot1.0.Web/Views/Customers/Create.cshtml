@model ParkingLot1._0.Application.Features.Customers.Commands.CreateCustomer.CreateCustomerCommand

@{
    ViewData["Title"] = "Crear Cliente";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0"><i class="bi bi-person-plus"></i> Registrar Nuevo Cliente</h3>
        </div>
        <div class="card-body">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="FirstName" class="form-label font-weight-bold">Nombre</label>
                        <input asp-for="FirstName" class="form-control" placeholder="Ej: Juan" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="LastName" class="form-label font-weight-bold">Apellido</label>
                        <input asp-for="LastName" class="form-control" placeholder="Ej: Pérez" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="DocumentType" class="form-label font-weight-bold">Tipo de Documento</label>
                        <select asp-for="DocumentType" class="form-select">
                            <option value="">Seleccione...</option>
                            <option value="CC">Cédula de Ciudadanía</option>
                            <option value="CE">Cédula de Extranjería</option>
                            <option value="NIT">NIT</option>
                        </select>
                        <span asp-validation-for="DocumentType" class="text-danger"></span>
                    </div>
                    <div class="col-md-8 mb-3">
                        <label asp-for="DocumentNumber" class="form-label font-weight-bold">Número de Documento</label>
                        <input asp-for="DocumentNumber" class="form-control" />
                        <span asp-validation-for="DocumentNumber" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Phone" class="form-label font-weight-bold">Teléfono de Contacto</label>
                        <input asp-for="Phone" class="form-control" placeholder="300..." />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="CustomerType" class="form-label font-weight-bold">Categoría de Cliente</label>
                        <select asp-for="CustomerType" class="form-select">
                            <option value="Frecuente">Cliente Frecuente</option>
                            <option value="Ocasional">Cliente Ocasional</option>
                            <option value="Empresarial">Empresarial / Convenio</option>
                        </select>
                        <span asp-validation-for="CustomerType" class="text-danger"></span>
                    </div>
                </div>

                <hr />
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Guardar Cliente
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}