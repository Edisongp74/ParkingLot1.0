
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-people"></i> Listado de Clientes</h2>
    <a asp-controller="Customers" asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus-fill"></i> Nuevo Cliente
    </a>
</div>

<table class="table table-striped shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>Nombre Completo</th>
            <th>Documento</th>
            <th>Teléfono</th>
            <th>Vehículos</th>
            <th>Estado Mensualidad</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var customer in Model)
        {
            <tr>
                <td>@customer.FullName</td>
                <td>@customer.DocumentNumber</td>
                <td>@customer.Phone</td>
                <td>@customer.TotalVehicles</td>
                <td>
                    @if (customer.HasActivePass)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Vencido</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@customer.Id" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@customer.Id" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>