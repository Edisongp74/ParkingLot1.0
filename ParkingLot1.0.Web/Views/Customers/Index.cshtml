@model ParkingLot1._0.Application.Common.PagedList<ParkingLot1._0.Web.Models.CustomerViewModel>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-people"></i> Listado de Clientes</h2>
    <a asp-controller="Customers" asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus-fill"></i> Nuevo Cliente
    </a>
</div>

<table class="table table-striped shadow-sm">
    <thead class="table-dark text-center">
        <tr>
            <th class="text-start ps-3">Nombre Completo</th>
            <th>Documento</th>
            <th>Teléfono</th>
            <th>Vehículos</th>
            <th>Estado Mensualidad</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var customer in Model.Items)
        {
            <tr>
                <td class="align-middle">@customer.FullName</td>
                <td class="text-center align-middle">@customer.DocumentNumber</td>
                <td class="text-center align-middle">@customer.Phone</td>
                <td class="text-center align-middle">
                    <span class="badge rounded-pill bg-light text-dark border px-2">
                        @customer.TotalVehicles
                    </span>
                </td>

                <td class="text-center align-middle">
                    @if (customer.HasActivePass)
                    {
                        <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-3 py-2">
                            <i class="bi bi-check-lg me-1"></i> Activo
                        </span>
                    }
                    else
                    {
                        <div class="d-flex flex-column align-items-center gap-2">
                            <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle px-3 py-1">
                                Vencido
                            </span>
                            <a asp-action="BuyPass" asp-route-id="@customer.Id"
                               class="btn btn-sm text-white rounded-pill px-3 shadow-sm"
                               style="background-color: #6f42c1; font-size: 0.8rem;">
                                <i class="bi bi-cart-plus-fill me-1"></i> Comprar
                            </a>
                        </div>
                    }
                </td>
                <td class="text-center align-middle">
                    <a asp-action="Edit" asp-route-id="@customer.Id" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@customer.Id" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="d-flex justify-content-between align-items-center mt-3 px-2">
    <div class="text-muted" style="font-size: 0.9rem;">
        Mostrando página <strong>@Model.PageIndex</strong> de <strong>@Model.TotalPages</strong> (Total de registros: @Model.TotalCount)
    </div>

    <nav aria-label="Paginacion">
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                <a class="page-item"
                   asp-action="Index"
                   asp-route-pageNumber="@(Model.PageIndex - 1)"
                   class="page-link shadow-sm">
                    <span class="page-link"><i class="bi bi-chevron-left"></i> Anterior</span>
                </a>
            </li>

            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                <a class="page-item"
                   asp-action="Index"
                   asp-route-pageNumber="@(Model.PageIndex + 1)"
                   class="page-link shadow-sm">
                    <span class="page-link">Siguiente <i class="bi bi-chevron-right"></i></span>
                </a>
            </li>
        </ul>
    </nav>
</div>