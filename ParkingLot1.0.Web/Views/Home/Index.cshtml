@{
    ViewData["Title"] = "Dashboard";
}

<div class="pagetitle mb-4">
    <h1>Dashboard</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item active">Dashboard</li>
        </ol>
    </nav>
</div>

<section class="section dashboard">
    <div class="row">
        <div class="col-lg-12">
            <div class="row">

                <div class="col-xxl-4 col-md-6">
                    <div class="card info-card customers-card shadow-sm border-0">
                        <div class="card-body">
                            <h5 class="card-title text-muted small uppercase">Clientes <span>| Total</span></h5>
                            <div class="d-flex align-items-center">
                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center" style="background: #f6f6fe; width: 64px; height: 64px;">
                                    <i class="bi bi-people text-primary" style="font-size: 32px;"></i>
                                </div>
                                <div class="ps-3">
                                    <h6 class="mb-0" style="font-size: 28px; font-weight: 700; color: #012970;">@ViewBag.TotalClientes</h6>
                                    <span class="text-success small pt-1 fw-bold">12%</span> <span class="text-muted small pt-2 ps-1">aumento</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xxl-4 col-md-6">
                    <div class="card info-card sales-card shadow-sm border-0">
                        <div class="card-body">
                            <h5 class="card-title text-muted small uppercase">Vehículos <span>| Hoy</span></h5>
                            <div class="d-flex align-items-center">
                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center" style="background: #e0f7ec; width: 64px; height: 64px;">
                                    <i class="bi bi-car-front text-success" style="font-size: 32px;"></i>
                                </div>
                                <div class="ps-3">
                                    <h6 class="mb-0" style="font-size: 28px; font-weight: 700; color: #012970;">@ViewBag.TotalVehiculos</h6>
                                    <span class="text-success small pt-1 fw-bold">8%</span> <span class="text-muted small pt-2 ps-1">aumento</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xxl-4 col-md-12">
                    <div class="card info-card revenue-card shadow-sm border-0">
                        <div class="card-body">
                            <h5 class="card-title text-muted small uppercase">Ingresos <span>| Este Mes</span></h5>
                            <div class="d-flex align-items-center">
                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center" style="background: #fff2e1; width: 64px; height: 64px;">
                                    <i class="bi bi-currency-dollar text-warning" style="font-size: 32px;"></i>
                                </div>
                                <div class="ps-3">
                                    <h6 class="mb-0" style="font-size: 28px; font-weight: 700; color: #012970;">
                                        $@string.Format("{0:N2}", ViewBag.TotalIngresosMes ?? 0)
                                    </h6>
                                    <span class="text-success small pt-1 fw-bold">8%</span> <span class="text-muted small pt-2 ps-1">aumento</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 mt-4">
                    <div class="card shadow-sm border-0">
                        <div class="card-body">
                            <h5 class="card-title text-muted small uppercase">Reportes <span>/ Actividad</span></h5>
                            <div style="min-height: 400px;">
                                <canvas id="reportsChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const ctx = document.getElementById('reportsChart').getContext('2d');

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: @Html.Raw(Json.Serialize(ViewBag.GraficaLabels)),
                    datasets: [{
                        label: 'Ventas',
                        data: @Html.Raw(Json.Serialize(ViewBag.GraficaVentas)),
                        fill: false,
                        borderColor: 'rgba(65, 84, 241, 1)',
                        backgroundColor: 'rgba(65, 84, 241, 1)',
                        borderWidth: 3,
                        tension: 0.4,
                        pointRadius: 5,
                        yAxisID: 'yCantidades'
                    }, {
                        label: 'Ingresos',
                        data: @Html.Raw(Json.Serialize(ViewBag.GraficaIngresos)),
                        fill: true,
                        backgroundColor: 'rgba(46, 202, 106, 0.1)',
                        borderColor: 'rgba(46, 202, 106, 1)',
                        borderWidth: 3,
                        tension: 0.4,
                        pointRadius: 5,
                        yAxisID: 'y'
                    }, {
                        label: 'Clientes',
                        data: @Html.Raw(Json.Serialize(ViewBag.GraficaClientes)),
                        fill: false,
                        borderColor: 'rgba(255, 119, 17, 1)',
                        backgroundColor: 'rgba(255, 119, 17, 1)', // Color firme para la leyenda naranja
                        borderWidth: 3,
                        tension: 0.4,
                        pointRadius: 5,
                        yAxisID: 'yCantidades'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: true, position: 'bottom' }
                    },
                    scales: {
                        y: {
                            type: 'linear',
                            display: true,
                            position: 'left',
                            beginAtZero: true,
                            title: { display: true, text: 'Ingresos ($)' },
                            grid: { color: '#f2f2f2' }
                        },
                        yCantidades: {
                            type: 'linear',
                            display: true,
                            position: 'right',
                            beginAtZero: true,
                            title: { display: true, text: 'Cantidad (Unidades)' },
                            ticks: { stepSize: 1, precision: 0 },
                            grid: { drawOnChartArea: false }
                        },
                        x: { grid: { display: false } }
                    }
                }
            });
        });
    </script>
}