@model ParkingLot1._0.Web.Models.CashReportViewModel

@{
    ViewData["Title"] = "Reporte de Caja e Ingresos";
}

<h2>Reporte de Caja e Ingresos</h2>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card p-3">
            <h5>Total ingresos</h5>
            <p>@Model.TotalIncome</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3">
            <h5>Total pagos</h5>
            <p>@Model.TotalPayments</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3">
            <h5>Pagos de mensualidad</h5>
            <p>@Model.TotalMonthlyPayments</p>
        </div>
    </div>
</div>

@if (!Model.Payments.Any())
{
    <div class="alert alert-warning">No hay pagos confirmados.</div>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Cliente</th>
                <th>Monto</th>
                <th>Método</th>
                <th>Tipo</th>
                <th>Referencia</th>
                <th>Pagado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Payments)
            {
                <tr>
                    <td>@item.CustomerName</td>
                    <td>@item.Amount</td>
                    <td>@item.PaymentMethod</td>
                    <td>@item.PaymentType</td>
                    <td>@item.Reference</td>
                    <td>@(item.PaidAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                </tr>
            }
        </tbody>
    </table>
}