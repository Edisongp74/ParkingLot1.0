@model ParkingLot1._0.Application.DTOs.Payments.CreatePaymentDto
@using ParkingLot1._0.Domain.Entities

@{
    ViewData["Title"] = "Registrar Pago";
    var paymentMethods = ViewBag.PaymentMethods as List<PaymentMethod>;
}

<h2>Registrar Pago</h2>

<form asp-controller="Payments" asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="CustomerId" />
    <input type="hidden" asp-for="MonthlyMembershipId" />
    <input type="hidden" asp-for="PaymentType" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Amount" class="form-label">Monto</label>
        <input asp-for="Amount" class="form-control" />
        <span asp-validation-for="Amount" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PaymentMethodId" class="form-label">Método de Pago</label>
        <select asp-for="PaymentMethodId" class="form-control">
            <option value="">Seleccione un método</option>
            @if (paymentMethods != null)
            {
                @foreach (var method in paymentMethods)
                {
                    <option value="@method.Id">@method.Name</option>
                }
            }
        </select>
        <span asp-validation-for="PaymentMethodId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Reference" class="form-label">Referencia</label>
        <input asp-for="Reference" class="form-control" />
        <span asp-validation-for="Reference" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Registrar Pago</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}