@model List<ParkingLot1._0.Application.UseCases.Roles.Queries.GetRolesList.RoleListItemDTO>

@{
    ViewData["Title"] = "Roles";
}

<h2>Gestión de Roles</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Nuevo Rol</a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Nombre</th>
            <th style="width:200px;">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var role in Model)
        {
            <tr>
                <td>@role.Name</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@role.Id" class="btn btn-warning btn-sm">Editar</a>
                    <form asp-action="Delete" asp-route-id="@role.Id" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>