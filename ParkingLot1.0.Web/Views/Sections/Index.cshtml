@using ParkingLot1._0.Application.Features.Sections.Queries.GetSectionsList
@model PagedResult<SectionDto>

@{
    ViewData["Title"] = "Zonas del Parqueadero";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-layers-half"></i> Secciones del Parqueadero</h2>
        <a asp-controller="Sections" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle-fill"></i> Nueva Sección
        </a>
    </div>

    <div class="card shadow">
        <div class="card-body p-0">
            <table class="table table-striped mb-0">
                <thead class="table-dark text-center">
                    <tr>
                        <th class="text-start ps-3" style="width: 15%">ID Seccional</th>
                        <th style="width: 35%">Nombre de la Zona</th>
                        <th style="width: 50%">Descripción / Notas</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Items != null && Model.Items.Count > 0)
                    {
                        @foreach (var seccion in Model.Items)
                        {
                            <tr>
                                <td class="text-start ps-3 align-middle">@seccion.Id</td>
                                <td class="text-center align-middle"><strong>@seccion.Name</strong></td>
                                <td class="text-start align-middle">@seccion.Description</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">
                                <i class="bi bi-info-circle me-1"></i> No hay secciones configuradas.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model != null && Model.TotalPages > 1)
        {
            <div class="card-footer d-flex justify-content-between align-items-center bg-white border-top py-3 px-4">
                <div class="text-muted" style="font-size: 0.9rem;">
                    Página <strong>@Model.PageNumber</strong> de <strong>@Model.TotalPages</strong>
                </div>

                <nav aria-label="Paginacion de secciones">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                            <a asp-action="Index" asp-route-pageNumber="@(Model.PageNumber - 1)" class="page-link shadow-sm">
                                <i class="bi bi-chevron-left"></i> Anterior
                            </a>
                        </li>

                        <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                            <a asp-action="Index" asp-route-pageNumber="@(Model.PageNumber + 1)" class="page-link shadow-sm">
                                Siguiente <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>