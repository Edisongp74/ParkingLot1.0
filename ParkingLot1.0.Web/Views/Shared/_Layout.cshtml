<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - ParkingLot 1.0</title>

    <link href="~/assets/css/style.min.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        /* Forzamos visibilidad si el JS falla */
        #main-wrapper {
            opacity: 1 !important;
            display: block !important;
        }

        .left-sidebar {
            width: 250px;
            position: absolute;
            min-height: 100vh;
            background: #fff;
            box-shadow: 1px 0 20px rgba(0,0,0,.08);
        }

        .page-wrapper {
            margin-left: 250px;
            padding: 20px;
            background-color: #f6f9ff;
            min-height: 100vh;
        }

        .sidebar-nav ul {
            list-style: none;
            padding: 20px;
        }

        .sidebar-nav li {
            margin-bottom: 15px;
        }

        .sidebar-nav a {
            text-decoration: none;
            color: #333;
            display: flex;
            align-items: center;
        }

        .sidebar-nav i {
            margin-right: 10px;
            font-size: 1.2rem;
            color: #3699ff;
        }
    </style>
</head>

<body>
    <div id="main-wrapper" data-layout="vertical" data-sidebartype="full">

        <header class="topbar" style="background: #1f262d; color: white; padding: 10px 20px;">
            <span class="logo-text">PARKING LOT 1.0</span>
        </header>

        <aside class="left-sidebar">
            <nav class="sidebar-nav">
                <ul id="sidebarnav">
                    <li class="sidebar-item">
                        <a class="sidebar-link" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-speedometer2"></i><span>Dashboard</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a class="sidebar-link" asp-controller="Customers" asp-action="Index">
                            <i class="bi bi-people"></i><span>Clientes</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a class="sidebar-link" asp-controller="Vehicles" asp-action="Index">
                            <i class="bi bi-car-front"></i><span>Vehículos</span>
                        </a>
                    </li>
                </ul>
            </nav>
        </aside>

        <div class="page-wrapper">
            <div class="container-fluid">
                @RenderBody()
            </div>
            <footer class="text-center py-4">
                &copy; 2026 - ParkingLot 1.0
            </footer>
        </div>
    </div>

    <script src="~/assets/libs/jquery/dist/jquery.min.js"></script>
    <script src="~/assets/libs/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/custom.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>