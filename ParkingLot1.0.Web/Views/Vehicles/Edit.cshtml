@model ParkingLot1._0.Application.Features.Vehicles.Commands.UpdateVehicle.UpdateVehicleCommand

@{
    ViewData["Title"] = "Editar Vehículo";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-warning text-dark">
            <h3 class="mb-0"><i class="bi bi-car-front-fill"></i> Editar Vehículo</h3>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="LicensePlate" class="form-label font-weight-bold">Placa</label>
                        <input asp-for="LicensePlate" class="form-control text-uppercase" />
                        <span asp-validation-for="LicensePlate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="CustomerId" class="form-label font-weight-bold">Propietario</label>
                        <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.Customers">
                            <option value="">-- Seleccionar Cliente --</option>
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Brand" class="form-label font-weight-bold">Marca</label>
                        <input asp-for="Brand" class="form-control" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Color" class="form-label font-weight-bold">Color</label>
                        <input asp-for="Color" class="form-control" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Type" class="form-label font-weight-bold">Tipo</label>
                        <input asp-for="Type" class="form-control" />
                    </div>
                </div>

                <hr />
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-arrow-repeat"></i> Actualizar Vehículo
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}