@model ParkingLot1._0.Application.Common.PagedList<object>

@{
    ViewData["Title"] = "Gestión de Vehículos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-car-front-fill"></i> Listado de Vehículos</h2>
        <a asp-controller="Vehicles" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle-fill"></i> Nuevo Vehículo
        </a>
    </div>

    <div class="card shadow">
        <div class="card-body p-0">
            <table class="table table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Placa</th>
                        <th>Tipo</th>
                        <th>Marca</th>
                        <th>Color</th>
                        <th>Dueño / Cliente</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (dynamic vehicle in Model.Items)
                    {
                        <tr>
                            <td class="align-middle font-weight-bold">
                                <span class="badge bg-secondary text-uppercase">@vehicle.LicensePlate</span>
                            </td>
                            <td class="align-middle">@vehicle.Type</td>
                            <td class="align-middle">@vehicle.Brand</td>
                            <td class="align-middle">@vehicle.Color</td>
                            <td class="align-middle">
                                @(vehicle.Customer != null
                                                            ? $"{vehicle.Customer.FirstName} {vehicle.Customer.LastName}"
                                                            : "Sin asignar")
                            </td>
                            <td class="text-center align-middle">
                                <div class="btn-group" role="group">
                                    <a asp-action="Edit" asp-route-id="@vehicle.Id" class="btn btn-warning btn-sm">
                                        <i class="bi bi-pencil-square"></i> Editar
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@vehicle.Id" class="btn btn-danger btn-sm">
                                        <i class="bi bi-trash"></i> Eliminar
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card-footer d-flex justify-content-between align-items-center bg-white border-top py-3 px-4">
            <div class="text-muted" style="font-size: 0.9rem;">
                Mostrando página <strong>@Model.PageIndex</strong> de <strong>@Model.TotalPages</strong> (Total de registros: @Model.TotalCount)
            </div>

            <nav aria-label="Paginacion de vehiculos">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a asp-action="Index" asp-route-pageNumber="@(Model.PageIndex - 1)" class="page-link shadow-sm">
                            <i class="bi bi-chevron-left"></i> Anterior
                        </a>
                    </li>

                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a asp-action="Index" asp-route-pageNumber="@(Model.PageIndex + 1)" class="page-link shadow-sm">
                            Siguiente <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>